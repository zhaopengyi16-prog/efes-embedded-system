# Initial DE1-SoC target from the project hardware proposal.
# Verify the actual board revision before programming hardware.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY efes_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001
set_global_assignment -name VERILOG_FILE ../rtl/efes_top.v
set_global_assignment -name SDC_FILE efes_fpga.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# Terasic DE1-SoC manual: CLOCK_50, KEY[0], and LEDR[0].
set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_AA14 -to KEY0_N
set_location_assignment PIN_V16 -to LEDR0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY0_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR0
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"

# Explicit output drive settings for the low-speed onboard LED.
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to LEDR0
set_instance_assignment -name SLEW_RATE 0 -to LEDR0
