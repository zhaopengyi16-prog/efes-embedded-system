# CYC5000 (TEI0050-01-AAH13A) bring-up project.
# Pin locations copied from the Trenz TEI0050 test_board reference design.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA2U15C8
set_global_assignment -name TOP_LEVEL_ENTITY cyc5000_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE ../rtl/cyc5000_top.v
set_global_assignment -name VERILOG_FILE ../rtl/sample_tick.v
set_global_assignment -name VERILOG_FILE ../rtl/uart_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/uart_tx.v
set_global_assignment -name VERILOG_FILE ../rtl/mcp4921_dac.v
set_global_assignment -name VERILOG_FILE ../rtl/sine_lut.v
set_global_assignment -name VERILOG_FILE ../rtl/pmod_ad1_reader.v
set_global_assignment -name VERILOG_FILE ../rtl/capture_dump.v
set_global_assignment -name VERILOG_FILE ../rtl/recorder.v
set_global_assignment -name SDC_FILE efes_cyc5000.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"

set_location_assignment PIN_F14 -to CLK12M
set_location_assignment PIN_L17 -to USER_BTN
set_location_assignment PIN_E18 -to UART_RX
set_location_assignment PIN_F16 -to UART_TX
# MCP4921 DAC on the Arduino header: D2 / D3 / D4
set_location_assignment PIN_J18 -to DAC_CS_N
set_location_assignment PIN_G18 -to DAC_SCK
set_location_assignment PIN_D18 -to DAC_SDI
# ADC121S021 on the Arduino header: D7 / D8 / D9
set_location_assignment PIN_E1 -to ADC_CS_N
set_location_assignment PIN_F1 -to ADC_SCLK
set_location_assignment PIN_J1 -to ADC_SDATA
set_location_assignment PIN_P4 -to LED[0]
set_location_assignment PIN_M4 -to LED[1]
set_location_assignment PIN_M3 -to LED[2]
set_location_assignment PIN_N3 -to LED[3]
set_location_assignment PIN_V2 -to LED[4]
set_location_assignment PIN_T2 -to LED[5]
set_location_assignment PIN_L1 -to LED[6]
set_location_assignment PIN_K1 -to LED[7]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK12M
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to USER_BTN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DAC_CS_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DAC_SCK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DAC_SDI
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_CS_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_SCLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_SDATA
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[*]

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top